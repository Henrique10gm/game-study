{
  "name": "quest-hall",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "gen:assets": "node scripts/compose-assets.mjs",
    "compose:assets": "node scripts/compose-assets.mjs",
    "build:appsscript": "tsc --noEmit && vite build --mode appsscript --outDir dist-gas --emptyOutDir && node scripts/inline-html.mjs",
    "deploy:appsscript": "npm run build:appsscript && npx clasp push --force",
    "sheet:rascunho": "node scripts/questions-sheet.mjs rascunho",
    "sheet:exportar": "node scripts/questions-sheet.mjs exportar"
  },
  "dependencies": {
    "@fontsource-variable/merriweather": "^5.3.0",
    "@fontsource-variable/merriweather-sans": "^5.3.0",
    "phaser": "3.90.0"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@types/node": "^24",
    "jsdom": "^26.1.0",
    "typescript": "~5.9.3",
    "vite": "^7.3.6",
    "vitest": "^3.2.7"
  }
}
